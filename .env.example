# Copy to .env and fill in. .env is gitignored; this file is not.
# Never put a real value in here.

# --- Database ---------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_NAME=routeler
DB_USER=
DB_PASS=
# Managed databases (Aiven) require TLS. Path to the CA certificate
# inside the container; leave empty for the local compose database.
DB_SSL_CA=

# --- Mapbox -----------------------------------------------------------
# Public token (pk.*). Safe in the browser, but restrict it by URL in the
# Mapbox dashboard — that is what stops someone spending your quota.
MAPBOX_TOKEN=

# --- OAuth ------------------------------------------------------------
# github.com > Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google is optional. Leave blank and the button simply does not appear.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the callback URL registered with the provider, exactly.
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback.php
APP_URL=http://localhost:8080

# --- Environment ------------------------------------------------------
# dev turns on verbose errors. Anything else in production.
APP_ENV=dev
